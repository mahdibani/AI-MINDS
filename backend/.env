# ─────────────────────────────────────────────────────────────────────────────
# RLM – Environment Configuration (Ollama + Daytona)
# ─────────────────────────────────────────────────────────────────────────────

# ── API Keys ──────────────────────────────────────────────────────────────────

OPENAI_API_KEY=*********
DAYTONA_API_KEY=dtn_a43ad29f0a961ab6a2a3457371491cd6a89a1910c0fe0dffb8273bfac1d872c8
DAYTONA_API_URL=https://app.daytona.io/api

# ── LLM Server (Ollama) ───────────────────────────────────────────────────────

# Ollama exposes an OpenAI-compatible API at port 11434
RLM_API_URL=http://localhost:11434/v1

# Ollama does not require an API key – use any non-empty string
RLM_API_KEY=ollama

# ── Model Selection ───────────────────────────────────────────────────────────

# Root (orchestrator) – best reasoning model available locally
# phi4-mini is stronger at synthesis and multi-step reasoning
RLM_ROOT_MODEL=phi4-mini:latest

# Worker / sub-agent – fast, lightweight, runs many parallel chunks cheaply
# qwen2.5:3b is the fastest in your list at 1.9 GB
RLM_WORKER_MODEL=qwen2.5:3b

# Sub-LLM alias (must match RLM_WORKER_MODEL)
RLM_SUB_MODEL=qwen2.5:3b

# ── Pipeline Tuning ───────────────────────────────────────────────────────────

# Small models have ~32K token context windows (~128K chars max).
# Using 24K chars per chunk leaves room for the task prompt + output.
RLM_CHUNK_SIZE=24000

# Overlap to avoid losing context at chunk boundaries
RLM_CHUNK_OVERLAP=300

# Parallel workers – keep at 2 on a local machine to avoid OOM
# Increase to 4 if you have 16+ GB RAM
RLM_MAX_WORKERS=2

# Max root-LLM iterations in the REPL loop
RLM_MAX_ITERATIONS=15

# ── Filesystem Sandbox (Daytona) ──────────────────────────────────────────────

# Daytona workspaces mount your project at /workspace
# /tmp/rlm is the scratch dir for generated files
RLM_ALLOWED_ROOTS=/workspace,/tmp/rlm

# ── Logging ───────────────────────────────────────────────────────────────────

RLM_LOG_DIR=logs